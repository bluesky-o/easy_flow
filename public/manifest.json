{
  "manifest_version": 3,
  "name": "Easy Flow",
  "version": "0.2",
  "description": "A bookmark manager that works across Chrome, Firefox, and Brave.",

  "permissions": [
    "tabs",
    "storage"
  ],

  "action": { 
    "default_popup": "popup.html",
    "default_title": "Easy Flow"
  },

  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "easyflow@extension",
      "strict_min_version": "128.0"
    }
  }
}